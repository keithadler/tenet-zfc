#!/usr/bin/env python3
"""Totals of a define-all run and its verification (docs/milestone3.md, "The Init-wide run").

usage: scripts/summarize-all <outdir>

A theorem-all run (its folder holds theorem-all.shape) gets its own totals: theorems proved, refused, over the budget,
failed; the blockers ranked; checker failures; proof sizes and times.

Reads every chunk-NNNN.tsv (what define-all translated) and chunk-NNNN.verify (what scripts/verify-all checked), and
prints: constants translated, by kind; equations and computation rules emitted and verified; refusals by reason;
theorems that failed a checker; output size and checker time.
"""
import collections
import glob
import os
import re
import sys


def category(reason):
    r = re.sub(r"^\S+ is (not|a|an) ", r"X is \1 ", reason)
    r = re.sub(r"^\S+: the name has", "X: the name has", r)
    r = re.sub(r"^\S+ (is a mutual|is a recursive|is an indexed|has a field|has a premise)", r"X \1", r)
    r = re.sub(r"\(.*\)$", "", r)
    r = re.sub(r"lean\.\S+", "lean.X", r)
    r = re.sub(r"\bno hypothesis .*", "no hypothesis …", r)
    r = re.sub(r"came out as .*", "came out as …", r)
    r = re.sub(r"(the hole \S+ does not occur in) .*", r"\1 …", r)
    r = re.sub(r"^\S+'s definition has \d+ symbols", "X's definition has N symbols", r)
    return r.strip()[:150]


def main(out):
    if os.path.exists(os.path.join(out, "theorem-all.shape")):
        return theorems(out)
    rows = []
    for f in sorted(glob.glob(os.path.join(out, "chunk-*.tsv"))):
        chunk = os.path.basename(f)[:-4]
        with open(f) as fh:
            next(fh)
            for line in fh:
                name, kind, status, eq, iota, isteps, secs, reason = line.rstrip("\n").split("\t")
                rows.append(dict(chunk=chunk, name=name, kind=kind, status=status, eq=int(eq), iota=iota,
                                 isteps=int(isteps), secs=float(secs), reason=reason))
    verify = {}
    for f in glob.glob(os.path.join(out, "chunk-*.verify")):
        cols = open(f).read().rstrip("\n").split("\t")
        verify[cols[0]] = dict(result=cols[1], bytes=int(cols[2]), theorems=int(cols[3]), mm=float(cols[5]),
                               mv=float(cols[7]), dc=float(cols[9]), failing=set(cols[10].split()) if len(cols) > 10 else set())
    chunks = sorted({r["chunk"] for r in rows})
    unverified = [c for c in chunks if c not in verify]
    print(f"chunks: {len(chunks)} translated, {len(verify)} checked, {sum(v['result'] == 'pass' for v in verify.values())} passed all three checkers")
    if unverified:
        print(f"  not yet checked: {' '.join(unverified)}")

    print(f"\nconstants: {len(rows)}")
    by_kind = collections.defaultdict(list)
    for r in rows:
        by_kind[r["kind"]].append(r)
    for kind, rs in sorted(by_kind.items(), key=lambda kv: -len(kv[1])):
        ok = [r for r in rs if r["status"] == "ok"]
        print(f"  {kind:<12} {len(rs):6}: {len(ok):6} translated with their equations, "
              f"{sum(r['status'] == 'refused' for r in rs):6} refused, {sum(r['status'] == 'error' for r in rs):5} errors")

    # A theorem counts as verified when its chunk was checked and no checker named it. When a chunk fails only
    # mmj2's or mmverify's check, the theorems metamath-exe didn't name are still counted, and the chunk is listed.
    def verified(r, suffix):
        v = verify.get(r["chunk"])
        # Labels as Model.LabelPart writes them: a set.mm label can't hold { } or ,
        label = r["name"].replace("{", "u").replace(",", "_").replace("}", "")
        return v is not None and f"lean-{label}-{suffix}" not in v["failing"]

    eqs = [r for r in rows if r["status"] == "ok"]
    iotas = [r for r in rows if r["iota"] == "ok"]
    print(f"\nequations emitted: {len(eqs)}, verified: {sum(verified(r, 'eq') for r in eqs)}")
    print(f"computation rules emitted: {len(iotas)}, verified: {sum(verified(r, 'iota') for r in iotas)}; "
          f"none needed (into Prop): {sum(r['iota'] == 'none-needed' for r in rows)}; "
          f"refused: {sum(r['iota'] == 'refused' for r in rows)}; errors: {sum(r['iota'] == 'error' for r in rows)}")
    print(f"proof steps (uncompressed count): {sum(r['eq'] for r in eqs):,} in equations, {sum(r['isteps'] for r in iotas):,} in computation rules")

    long_ = sorted({re.search(r"Theorem (\S+):", l).group(1) for f in glob.glob(os.path.join(out, "chunk-*.mmj2-long"))
                    for l in open(f) if "Theorem " in l})
    print(f"proofs too long for mmj2 (checked by metamath-exe and mmverify.py only): {len(long_)}"
          + (f", e.g. {', '.join(long_[:3])}" if long_ else ""))
    failing = sorted(set().union(*[v["failing"] for v in verify.values()])) if verify else []
    print(f"\ntheorems a checker rejected: {len(failing)}")
    for label in failing[:40]:
        print(f"  {label}")
    for c, v in sorted(verify.items()):
        if v["result"] != "pass" and not v["failing"]:
            print(f"  {c}: failed a checker without metamath-exe naming a theorem (see {c}.verify.log)")

    print("\nwhy the others aren't translated (refusals, errors, refused computation rules):")
    reasons = collections.Counter()
    example = {}
    for r in rows:
        if r["reason"]:
            k = category(r["reason"])
            reasons[k] += 1
            example.setdefault(k, r["name"])
    for k, n in reasons.most_common(30):
        print(f"  {n:6}  {k}  (e.g. {example[k]})")

    size = sum(v["bytes"] for v in verify.values())
    print(f"\noutput: {size / 2**20:.1f} MiB in {len(verify)} checked chunks")
    print(f"checker time, summed over chunks: metamath-exe {sum(v['mm'] for v in verify.values()):.0f}s, "
          f"mmverify.py {sum(v['mv'] for v in verify.values()):.0f}s, definitionCheck {sum(v['dc'] for v in verify.values()):.0f}s")
    print(f"translation time, summed over constants: {sum(r['secs'] for r in rows):.0f}s")
    print("slowest constants:")
    for r in sorted(rows, key=lambda r: -r["secs"])[:10]:
        print(f"  {r['secs']:7.0f}s  {r['name']} ({r['eq']:,} + {r['isteps']:,} steps, {r['status']})")


def read_verify(out):
    verify = {}
    for f in glob.glob(os.path.join(out, "chunk-*.verify")):
        cols = open(f).read().rstrip("\n").split("\t")
        verify[cols[0]] = dict(result=cols[1], bytes=int(cols[2]), theorems=int(cols[3]), mm=float(cols[5]),
                               mv=float(cols[7]), dc=float(cols[9]), failing=set(cols[10].split()) if len(cols) > 10 else set())
    return verify


def blocker(reason):
    """What stops a theorem, from its refusal: the construct (a typing rule, a conversion) or the constant."""
    r = reason
    m = re.match(r"no typing lemma yet for (\S+) \(an? (\w+)\)", r)
    if m:
        return f"no typing lemma for a {m.group(2)}", m.group(1)
    m = re.match(r"(\S+): the name has", r)
    if m:
        return "a name set.mm can't hold", m.group(1)
    m = re.match(r"typing (\S+) needs itself", r)
    if m:
        return "typing a constant needs itself", m.group(1)
    m = re.search(r"(lean\.[^ `]+)", r)
    const = m.group(1) if m else ""
    m = re.match(r"(\S+)'s set isn't unions of a singleton", r)
    if m:
        return "a projection out of a structure in Prop (And, Iff, a class of propositions)", m.group(1)
    if re.match(r"a field variable \S+ occurs in the hypotheses", r):
        return "a structure's field variable clashes with a bound variable of the hypotheses", ""
    if r.startswith("not a level of the tower"):
        return "an instance argument of a type former, typed as if it were a type (not a level of the tower)", const
    if re.match(r"not alpha-equivalent: \(/\)  vs  [a-z]\S*$", r):
        return "a proof (/) where a bound variable was expected (Sort u at level 0)", ""
    if re.match(r"not alpha-equivalent: \( \( \S+ e\. .* \|-> 2o \) ` ", r):
        return "a motive applied to an argument, needing beta on the term's side", const
    if "quotients and choice are not in the tower" in r:
        return "quotients or choice (refused before they were in the tower)", r.split(":")[0]
    if re.match(r"\S+ has a premise mentioning Acc", r):
        return "Acc and well-founded recursion", "Acc"
    if r.startswith("a proposition's cases aren't a disjunction"):
        return "cases of an indexed inductive proposition (Nat.le)", const
    if r.startswith("can't show ") or r.startswith("not alpha-equivalent"):
        return "a conversion the translator can't show (" + r.split(" ")[0] + "…)", const
    if r.startswith("no proof yet that"):
        return "a membership the translator can't show yet", const
    if "needs" in r and "distinct, but both contain" in r:
        return "a $d condition violated in a step (translator bug)", ""
    return category(r), const


def theorems(out):
    rows = []
    for f in sorted(glob.glob(os.path.join(out, "chunk-*.tsv"))):
        chunk = os.path.basename(f)[:-4]
        with open(f) as fh:
            next(fh)
            for line in fh:
                cols = line.rstrip("\n").split("\t")
                if len(cols) == 7:
                    cols.insert(6, cols[5])   # before cpu_seconds was recorded
                name, status, steps, lemmas, lsteps, secs, cpu, reason = cols
                rows.append(dict(chunk=chunk, name=name, status=status, steps=int(steps), lemmas=int(lemmas),
                                 lsteps=int(lsteps), secs=float(secs), cpu=float(cpu), reason=reason))
    verify = read_verify(out)
    print(open(os.path.join(out, "theorem-all.shape")).read().strip())
    chunks = sorted({r["chunk"] for r in rows})
    print(f"chunks: {len(chunks)} proved, {len(verify)} checked, {sum(v['result'] == 'pass' for v in verify.values())} passed all three checkers")
    unverified = [c for c in chunks if c not in verify]
    if unverified:
        print(f"  not yet checked: {' '.join(unverified)}")

    def label(name):
        # Model.LabelOf's spelling for plain names; an escaped name that a checker rejects still fails its chunk,
        # which counts it out below.
        name = name.replace("{", "u").replace(",", "_").replace("}", "")
        return "lean-thm-" + name

    proved = [r for r in rows if r["status"] == "proved"]
    failing = set().union(*[v["failing"] for v in verify.values()]) if verify else set()
    checked = [r for r in proved if r["chunk"] in verify]
    ok = [r for r in checked if label(r["name"]) not in failing and verify[r["chunk"]]["result"] == "pass"]
    n = len(rows)
    pct = lambda k: f"{100 * k / n:.1f}%" if n else "-"
    print(f"\ntheorems: {n}")
    for st in ["proved", "refused", "timeout", "error", "crash"]:
        k = sum(r["status"] == st for r in rows)
        print(f"  {st:<8} {k:6}  {pct(k)}")
    print(f"  proved and in a chunk that passed all three checkers: {len(ok)} ({pct(len(ok))}); proved, chunk not yet checked: {len(proved) - len(checked)}")
    print(f"\nchecker failures: {len(failing)} labels named")
    for l in sorted(failing)[:40]:
        print(f"  {l}")
    for c, v in sorted(verify.items()):
        if v["result"] != "pass":
            print(f"  {c}: FAIL (see {c}.verify.log)")

    print("\nwhat stops the others, by construct (refusals, timeouts, errors):")
    by = collections.Counter()
    ex = {}
    consts = collections.defaultdict(collections.Counter)
    for r in rows:
        if r["status"] in ("proved",):
            continue
        if r["status"] == "timeout":
            k, c = "over the time budget", ""
        elif r["status"] == "crash":
            k, c = "crashed the process", ""
        else:
            k, c = blocker(r["reason"])
            if r["status"] == "error":
                k = "ERROR: " + k
        by[k] += 1
        ex.setdefault(k, r["name"])
        if c:
            consts[k][c] += 1
    for k, cnt in by.most_common(40):
        top = ", ".join(f"{c} {m}" for c, m in consts[k].most_common(4))
        print(f"  {cnt:6}  {k}  (e.g. {ex[k]}){'; constants: ' + top if top else ''}")

    print("\nconstants named by refusals (all reasons), most first:")
    allc = collections.Counter()
    for k in consts:
        allc.update(consts[k])
    for c, m in allc.most_common(25):
        print(f"  {m:6}  {c}")

    def dist(xs, unit):
        xs = sorted(xs)
        if not xs:
            return "-"
        q = lambda p: xs[min(len(xs) - 1, int(p * len(xs)))]
        return f"median {q(0.5):,.1f}{unit}, 90% {q(0.9):,.1f}{unit}, 99% {q(0.99):,.1f}{unit}, max {xs[-1]:,.1f}{unit}"
    print(f"\nproof size of proved theorems (flat steps): {dist([r['steps'] for r in proved], '')}")
    print(f"CPU time of proved theorems: {dist([r['cpu'] for r in proved], 's')}")
    print(f"CPU time of refused theorems: {dist([r['cpu'] for r in rows if r['status'] == 'refused'], 's')}")
    print(f"translation time, summed: {sum(r['cpu'] for r in rows):.0f}s CPU, {sum(r['secs'] for r in rows):.0f}s wall")
    size = sum(v["bytes"] for v in verify.values())
    print(f"output: {size / 2**20:.1f} MiB in {len(verify)} checked chunks")
    if verify:
        print(f"checker time, summed over chunks: metamath-exe {sum(v['mm'] for v in verify.values()):.0f}s, "
              f"mmverify.py {sum(v['mv'] for v in verify.values()):.0f}s, definitionCheck {sum(v['dc'] for v in verify.values()):.0f}s")
    print("slowest proved:")
    for r in sorted(proved, key=lambda r: -r["cpu"])[:8]:
        print(f"  {r['cpu']:7.1f}s CPU  {r['name']} ({r['steps']:,} steps, {r['lemmas']} new lemmas)")


if __name__ == "__main__":
    if len(sys.argv) != 2:
        sys.exit(__doc__)
    main(sys.argv[1])
